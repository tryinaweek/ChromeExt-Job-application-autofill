{
  "manifest_version": 3,
  "name": "AutoJobFill AI",
  "version": "1.1",
  "description": "Auto-fill job applications with one click and customize summaries/skills using AI. Track all applications easily.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*",
        "file://*/*"
      ],
      "js": [
        "content/content.js",
        "content/widget.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoJobFill AI"
  }
}
